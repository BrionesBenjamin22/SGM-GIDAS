COMPOSE_SERVICE_PREFIX=gidas_prod
COMPOSE_NETWORK=gidas_prod_network
POSTGRES_VOLUME=gidas_prod_postgres_data
POSTGRES_DB=gidas_db
POSTGRES_ADMIN_USER=gidas_admin
POSTGRES_ADMIN_PASSWORD=replace-with-secure-admin-password
POSTGRES_APP_USER=gidas_app
POSTGRES_APP_PASSWORD=replace-with-secure-app-password
MIGRATION_DATABASE_URL=postgresql://gidas_admin:replace-with-secure-admin-password@db:5432/gidas_db
# 0.0.0.0 permite acceso por la red autorizada; 127.0.0.1 limita el proxy al host/SSH tunnel.
NGINX_BIND_ADDRESS=0.0.0.0
NGINX_PORT=8080
BACKEND_ENV_FILE=.env.production
VITE_APP_ENV=production
VITE_API_BASE_URL=/api/v1
VITE_API_URL=/api
VITE_SERVER_FILTER_PERSONAL=true
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5
